{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Hardware Optimized + Cached Release Build",
      "description": "Native Zen 4 AVX-512 optimization with sccache compiler launcher and Mold linker",
      "binaryDir": "${sourceDir}/build",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AQUAMARINE_ENABLE_NATIVE_OPT": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Debug configuration with AddressSanitizer",
      "binaryDir": "${sourceDir}/build-debug",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 16
    }
  ]
}
